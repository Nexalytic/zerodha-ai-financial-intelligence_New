# Application Settings
ENVIRONMENT=development
DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# CORS Allowed Origins (JSON list or comma-separated list)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]

# SQLite Database Location (relative to backend/ folder)
DATABASE_URL=sqlite+aiosqlite:///./data/zerodha.db

# Zero-cost policy: Mock / rule-based mode toggle (₹0 spend)
USE_MOCK_DATA=true

# Market Data Provider Configuration (Alpha Vantage)
# Leave empty to use offline deterministic demo data (₹0 spend)
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
MARKET_DATA_PROVIDER=demo

# AI Reasoning Provider Configuration (Groq)
# Leave empty to use offline deterministic demo reasoner (₹0 spend)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_PROVIDER=demo
